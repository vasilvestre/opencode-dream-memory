[Unit]
Description=Consolidate OpenCode sessions into a memory file

[Service]
Type=oneshot
# Portable defaults. If `opencode` lives outside them, put its directory in
# ~/.config/dream.env as PATH=/your/bin:/usr/local/bin:/usr/bin:/bin
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-%h/.config/dream.env
# install.sh rewrites the line below to the chosen BIN_DIR.
ExecStart=%h/.local/bin/dream

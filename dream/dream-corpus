#!/bin/sh
# Build the dream corpus: one line per message, for each session touched in the
# last 24 hours, in every listed project. Deterministic: no model, no cost.
# The dream's own runs are skipped: their output must not become tomorrow's
# source. Labelled secrets are redacted on the way in.
# Output: $DREAM_HOME/.dreams/session-corpus/YYYY-MM-DD.txt (default ~/dreams)
set -eu

root="${DREAM_HOME:-$HOME/dreams}"
list="${DREAM_PROJECTS:-$HOME/.config/opencode/dream-projects}"
day=$(date +%F)
now=$(( $(date +%s) * 1000 ))
hours=${DREAM_SINCE_HOURS:-24}
case $hours in ''|*[!0-9]*) hours=24 ;; esac
# Incremental, per project: each project ingests sessions since its own last
# successful run, never earlier than 24h ago. DREAM_SINCE_HOURS raises that
# floor, to catch up after missed runs. A project with no cursor is new,
# so it ingests its full 24h history instead of being skipped by another
# project's cursor. Without this, adding a project after a run silently drops
# its past sessions.
state="$root/.dreams/last-run"
[ -d "$state" ] || { rm -f "$state"; mkdir -p "$state"; }
command -v opencode >/dev/null || { echo "dream-corpus: opencode not on PATH" >&2; exit 1; }

out="$root/.dreams/session-corpus/$day.txt"
mkdir -p "$(dirname "$out")"
# truncate on the first run of the day, append afterwards so a later run keeps
# the earlier slice. shortcut: a retry after a failed run re-appends the same
# messages; dedupe with sort -u if that ever shows up.
[ -f "$out" ] || : > "$out"

# One line per message. A labelled secret never leaves the machine; a bare key
# with no label still gets through, so this is a net, not a guarantee.
filter='
def clean:
  gsub("\n"; " ")
  | gsub("(?i)(?<k>(api[_-]?key|token|password|passwd|secret|bearer)[[:space:]]*[:=][[:space:]]*)[^[:space:]]+"; "\(.k)[redacted]")
  | .[0:400];
.messages[] |
  if .type == "user" then
    "[" + $name + "] User: " + (.text // "" | clean)
  elif .type == "assistant" then
    (.content[]? | select(.type == "text") | .text | clean | "[" + $name + "] Assistant: " + .)
  else empty end
'

while IFS= read -r project; do
  case $project in ''|\#*) continue ;; esac
  [ -d "$project/.git" ] || { echo "dream-corpus: skip $project (not a git repo)" >&2; continue; }
  name=$(basename "$project")
  last=0
  [ -r "$state/$name" ] && last=$(cat "$state/$name" 2>/dev/null || true)
  case $last in ''|*[!0-9]*) last=0 ;; esac
  cutoff=$(( now - hours * 3600000 ))
  [ "$last" -gt "$cutoff" ] && cutoff=$last
  cd "$project"

  before=$(wc -l < "$out")
  opencode session list --format json --max-count 100 2>/dev/null |
    jq -r --argjson cutoff "$cutoff" '.[] | select(.updated >= $cutoff) | .id' |
    while IFS= read -r sid; do
      [ -n "$sid" ] || continue
      tmp=$(mktemp)
      if opencode session export "$sid" > "$tmp" 2>/dev/null; then
        # Never learn from the dream's own runs: they are output, not source.
        agent=$(jq -r '.info.agent // ""' "$tmp" 2>/dev/null) || agent=
        case $agent in
          dream-*) echo "dream-corpus: skip $sid (own $agent run)" >&2 ;;
          *) jq -r --arg name "$name" "$filter" "$tmp" >> "$out" ||
               echo "dream-corpus: skip $sid (unreadable export)" >&2 ;;
        esac
      fi
      rm -f "$tmp"
    done
  echo "dream-corpus: $name +$(( $(wc -l < "$out") - before )) lignes"
done < "$list"

echo "dream-corpus: $out ($(wc -l < "$out") lignes)"

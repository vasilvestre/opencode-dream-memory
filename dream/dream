#!/bin/sh
# Nightly session-memory pass.
#
# Usage: dream          corpus, then the light and deep passes (two agent runs)
#        dream corpus   corpus only, no model, no cost
#        dream status   one screen of state, read-only
#        dream reset    delete memory, diary, staging and corpus (asks first)
#
# Everything is written under $DREAM_HOME (default ~/dreams), never in the
# projects themselves: this is the agent's memory of the user, not project docs.
# Shared facts land in MEMORY.md, project facts in projects/<name>/MEMORY.md.
set -eu

# Resolve next to this script, so a custom BIN_DIR works without a PATH.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root="${DREAM_HOME:-$HOME/dreams}"

# One entry point. The standalone scripts stay installed and delegated to.
case "${1:-}" in
  status) exec "$here/dream-status" ;;
  corpus) exec "$here/dream-corpus" ;;
  reset)
    # Only $DREAM_HOME, and only when it looks like a dream home: a mistyped
    # DREAM_HOME must not delete something else.
    case $root in ''|/|"$HOME"|"$HOME/"|.) echo "dream: refusing to reset '$root'" >&2; exit 1 ;; esac
    if [ -e "$root" ] && [ ! -d "$root/.dreams" ] && [ ! -d "$root/dreaming" ]; then
      echo "dream: $root does not look like a dream home, refusing" >&2
      exit 1
    fi
    if [ "${2:-}" != "--yes" ]; then
      printf 'Delete every memory, diary and corpus under %s? [y/N] ' "$root" >&2
      read -r answer || answer=
      case $answer in y|Y|yes) ;; *) echo "dream: reset cancelled" >&2; exit 1 ;; esac
    fi
    rm -rf "$root/MEMORY.md" "$root/DREAMS.md" "$root/dreaming" "$root/projects" "$root/.dreams"
    mkdir -p "$root/dreaming/light" "$root/dreaming/deep" "$root/projects" "$root/.dreams/session-corpus"
    cat > "$root/MEMORY.md" <<'EOF'
# Shared memory

Facts true in every project, one per line. Project facts live in
`projects/<project>/MEMORY.md`.
EOF
    cat > "$root/DREAMS.md" <<'EOF'
# Dream Diary

One entry per night, newest first. Durable facts live in [MEMORY.md](MEMORY.md).

<!-- opencode:dreaming:diary:start -->
EOF
    echo "dream: reset done, $root is empty" >&2
    exit 0
    ;;
  '') ;;
  *) echo "dream: unknown command '$1' (try: dream, dream status, dream corpus, dream reset)" >&2; exit 2 ;;
esac

list="${DREAM_PROJECTS:-$HOME/.config/opencode/dream-projects}"
day=$(date +%F)
# One run at a time: two overlapping passes interleave writes and commits, and
# the 04:30 timer can fire while a manual run still spends its two models.
mkdir -p "$root/.dreams"
if command -v flock >/dev/null 2>&1; then
  exec 9>"$root/.dreams/run.lock"
  flock -n 9 || { echo "dream: another run is in progress" >&2; exit 0; }
fi
command -v opencode >/dev/null || { echo "dream: opencode not on PATH" >&2; exit 1; }
[ -r "$list" ] || { echo "dream: no project list at $list" >&2; exit 1; }

corpus_bin="${DREAM_CORPUS_BIN:-$here/dream-corpus}"
"$corpus_bin"

corpus="$root/.dreams/session-corpus/$day.txt"
[ -s "$corpus" ] || { echo "dream: empty corpus, nothing to do" >&2; exit 0; }

mkdir -p "$root/dreaming/light" "$root/dreaming/deep"
cd "$root"

# One memory file per tracked project, so the deep pass only ever edits files
# that exist. Named after the project directory, the same tag dream-corpus
# writes into the corpus.
while IFS= read -r project; do
  case $project in ''|\#*) continue ;; esac
  name=$(basename "$project")
  case $name in ''|.|..) continue ;; esac
  memory="$root/projects/$name/MEMORY.md"
  [ -f "$memory" ] && continue
  mkdir -p "$(dirname "$memory")"
  printf '# %s\n' "$name" > "$memory"
done < "$list"

# Per-stage model choice: "<stage> <model> [<model> ...]", first that works wins.
# The light pass reads raw session text, so this is where a local or paid
# provider matters. Missing file or missing stage falls back to the paid
# defaults below. Never fall back to a free model: sending the corpus to a
# provider that trains on its input is a downgrade nobody asked for.
models="${DREAM_MODELS:-$HOME/.config/opencode/dream-models}"

default_models() {
  case $1 in
    deep) echo "opencode-go/deepseek-v4-pro opencode-go/deepseek-v4.1-flash" ;;
    *) echo "opencode-go/deepseek-v4.1-flash opencode-go/deepseek-v4-pro" ;;
  esac
}

models_for() {
  found=
  if [ -r "$models" ]; then
    found=$(awk -v stage="$1" '$1 == stage { sub(/^[[:space:]]*[^[:space:]]+[[:space:]]+/, ""); print; exit }' "$models")
  fi
  printf '%s\n' "${found:-$(default_models "$1")}"
}

# --agent does not carry the model: a session keeps its own selected model, so
# pass -m explicitly, and fall back down the stage's list.
run_agent() {
  agent=$1; prompt=$2; title=$3
  for model in $(models_for "${agent#dream-}"); do
    echo "dream: $agent on $model" >&2
    if opencode run --agent "$agent" -m "$model" --title "$title" "$prompt"; then
      return 0
    fi
    echo "dream: $model unavailable, trying the next one" >&2
  done
  echo "dream: $agent failed on every model" >&2
  return 1
}

echo "dream: light"
run_agent dream-light \
  "Stage today's candidates from .dreams/session-corpus/$day.txt." "light $day"

# Preimage: a bad promotion then stays one `git checkout` away. Only when the
# data directory is a repo; install.sh does not create one. The corpus is
# excluded even when a .gitignore forgets it: session text must not enter git.
if git -C "$root" rev-parse --git-dir >/dev/null 2>&1; then
  git -C "$root" add -A -- . ':!.dreams' >/dev/null 2>&1 || true
  if ! git -C "$root" diff --cached --quiet; then
    git -C "$root" commit -qm "dream: before deep $day" ||
      echo "dream: preimage commit failed, check the git identity in $root" >&2
  fi
fi

echo "dream: deep"
if run_agent dream-deep \
  "Promote today's candidates and write the diary entry for $day." "deep $day"; then
  # Advance each project's cursor only after both passes succeeded, so a failed
  # run is retried on the same slice instead of losing it. A project without a
  # git repo is skipped by dream-corpus, so it keeps a zero cursor and its full
  # history is backfilled the first time it becomes a git repo.
  now_ms=$(date +%s%3N)
  mkdir -p "$root/.dreams/last-run"
  while IFS= read -r project; do
    case $project in ''|\#*) continue ;; esac
    [ -d "$project/.git" ] || continue
    name=$(basename "$project")
    printf '%s\n' "$now_ms" > "$root/.dreams/last-run/$name"
  done < "$list"
fi
